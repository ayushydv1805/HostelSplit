# Cloud mode is enabled only when both values are present.
# Use a dedicated Supabase project for HostelSplit. Do not reuse your VoicePrint
# or KnowMeBro project, because those projects contain other apps' data.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
